# ---- Server ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Storage ----
DB_PATH=./data/faceguard.sqlite
UPLOAD_DIR=./uploads

# ---- Reverse-image-search provider ----
# Which provider to use: "google_vision" | "tineye" | "mock"
SEARCH_PROVIDER=mock

# Google Cloud Vision (WEB_DETECTION). Most defensible for self-monitoring:
# it finds pages where YOUR image already appears. Get a key in Google Cloud Console.
GOOGLE_VISION_API_KEY=

# TinEye Commercial API (reverse image search).
TINEYE_API_URL=https://api.tineye.com/rest/search/
TINEYE_API_KEY=

# Minimum confidence (0..1) for a match to be returned to the user.
MATCH_MIN_CONFIDENCE=0.55

# ---- Billing (scaffold only, unwired) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# ---- AI face verification ----
# Confirms the user's own face in candidate results (detection + 128-d embedding).
# Set to "false" to fall back to image-match-only.
FACE_MATCH_ENABLED=true
FACE_MODELS_DIR=./models
# Euclidean-distance cutoff for "same person" on face-api descriptors.
FACE_MATCH_THRESHOLD=0.6
# How many top candidates to fetch + face-verify per scan.
FACE_VERIFY_MAX_CANDIDATES=20
