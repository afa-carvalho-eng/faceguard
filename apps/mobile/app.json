{
  "expo": {
    "name": "FaceGuard",
    "slug": "faceguard",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": { "backgroundColor": "#0b1020" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.faceguard.app" },
    "android": { "package": "com.faceguard.app" },
    "plugins": ["expo-image-picker", "expo-secure-store"],
    "extra": { "apiUrl": "http://localhost:4000" }
  }
}
